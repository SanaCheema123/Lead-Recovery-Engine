[
  {
    "id": "lrePostgres00001",
    "name": "LRE Postgres",
    "type": "postgres",
    "data": { "host": "postgres", "port": 5432, "database": "lre", "user": "${POSTGRES_USER}", "password": "${POSTGRES_PASSWORD}", "ssl": "disable" }
  },
  {
    "id": "lreOpenAi0000001",
    "name": "LRE OpenAI",
    "type": "openAiApi",
    "data": { "apiKey": "${OPENAI_API_KEY}" }
  },
  {
    "id": "lreTwilio0000001",
    "name": "LRE Twilio",
    "type": "twilioApi",
    "data": { "authType": "authToken", "accountSid": "${TWILIO_ACCOUNT_SID}", "authToken": "${TWILIO_AUTH_TOKEN}" }
  },
  {
    "id": "lreSendgrid00001",
    "name": "LRE SendGrid",
    "type": "httpHeaderAuth",
    "data": { "name": "Authorization", "value": "Bearer ${SENDGRID_API_KEY}" }
  },
  {
    "id": "lreGhl0000000001",
    "name": "LRE GoHighLevel",
    "type": "httpHeaderAuth",
    "data": { "name": "Authorization", "value": "Bearer ${GHL_PRIVATE_INTEGRATION_TOKEN}" }
  },
  {
    "id": "lreHubspot000001",
    "name": "LRE HubSpot",
    "type": "httpHeaderAuth",
    "data": { "name": "Authorization", "value": "Bearer ${HUBSPOT_PRIVATE_APP_TOKEN}" }
  },
  {
    "id": "lreCalcom0000001",
    "name": "LRE Cal.com",
    "type": "httpHeaderAuth",
    "data": { "name": "Authorization", "value": "Bearer ${CALCOM_API_KEY}" }
  }
]
