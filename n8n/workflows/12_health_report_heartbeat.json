{
  "id": "lre12HealthRepor",
  "name": "LRE 12 · Health Report & Heartbeat",
  "nodes": [
    {
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -260,
        -400
      ],
      "parameters": {
        "content": "## Health Report & Heartbeat\nDaily 8:00 AM: per-client KPIs (contacted, reply rate, qualified, booked, opt-outs, failures, AI tokens) to Slack.\nHourly: pings HEALTHCHECK_URL (dead-man switch — alerts you if n8n itself is down) and alerts on items needing attention.",
        "width": 520,
        "height": 260
      },
      "id": "26ce709a-5808-4767-ab5e-524b6bb2d692"
    },
    {
      "name": "Daily 8 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "1ec8a2d5-abb2-4160-a46a-cc34714b0fc0"
    },
    {
      "name": "Load KPIs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        260,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "lrePostgres00001",
          "name": "LRE Postgres"
        }
      },
      "alwaysOutputData": false,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "parameters": {
        "operation": "executeQuery",
        "query": "select k.client_name, k.leads_contacted, k.messages_sent, k.leads_replied, k.newly_qualified, k.appointments_booked,\n  k.handoffs, k.opt_outs, k.delivery_failures, k.prompt_tokens, k.completion_tokens,\n  f.reply_rate_pct, f.booking_rate_pct, f.hot, f.booked as booked_total,\n  (select count(*) from workflow_errors where created_at > now() - interval '24 hours') as errors_24h,\n  (select count(*) from v_attention_needed) as attention_items\nfrom v_daily_kpis k join v_funnel f on f.client_id = k.client_id\nwhere k.day = current_date - 1",
        "options": {}
      },
      "id": "1d708c46-51dd-4c01-a68c-ee7135d55f1f"
    },
    {
      "name": "Compose Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map((i) => i.json);\nif (!rows.length) return [];\nconst lines = rows.map((r) => '*' + r.client_name + '*\\n' +\n  '  Contacted ' + r.leads_contacted + ' | Replies ' + r.leads_replied + ' | Newly qualified ' + r.newly_qualified +\n  ' | Booked ' + r.appointments_booked + ' | Handoffs ' + r.handoffs + '\\n' +\n  '  Opt-outs ' + r.opt_outs + ' | Delivery failures ' + r.delivery_failures + ' | AI tokens ' + (Number(r.prompt_tokens) + Number(r.completion_tokens)) + '\\n' +\n  '  All-time: reply rate ' + (r.reply_rate_pct || 0) + '% | booking rate ' + (r.booking_rate_pct || 0) + '% | hot ' + r.hot + ' | booked ' + r.booked_total);\nconst text = ':bar_chart: *Lead Recovery Engine - yesterday*\\n' + lines.join('\\n\\n') +\n  '\\n\\nErrors (24h): ' + rows[0].errors_24h + ' | Items needing attention: ' + rows[0].attention_items;\nreturn [{ json: { text } }];\n"
      },
      "id": "b8f110a6-59ea-4318-a5af-f0dfda8bc9a2"
    },
    {
      "name": "Post Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL_ALERTS }}",
        "options": {
          "timeout": 20000
        },
        "authentication": "none",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "id": "54d48e27-acd8-4495-a684-1b6f9dabf748"
    },
    {
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        600
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 60
            }
          ]
        }
      },
      "id": "07be4b2d-a461-4156-a34a-01a37ed2b377"
    },
    {
      "name": "Health Check",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        260,
        600
      ],
      "credentials": {
        "postgres": {
          "id": "lrePostgres00001",
          "name": "LRE Postgres"
        }
      },
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "parameters": {
        "operation": "executeQuery",
        "query": "select (select count(*) from v_attention_needed) as attention,\n  (select count(*) from workflow_errors where created_at > now() - interval '1 hour') as errors_1h,\n  (select count(*) from messages where direction = 'outbound' and status in ('failed', 'undelivered') and created_at > now() - interval '1 hour') as failed_1h,\n  (select count(*) from messages where direction = 'outbound' and created_at > now() - interval '1 hour') as sent_1h",
        "options": {}
      },
      "id": "45c2bc90-1fdc-49b9-a16e-f5696df24137"
    },
    {
      "name": "Ping Healthcheck",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        400
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.HEALTHCHECK_URL || 'https://hc-ping.com/not-configured' }}",
        "options": {
          "timeout": 20000
        },
        "authentication": "none"
      },
      "retryOnFail": false,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "id": "d609956d-d12a-4d05-ae07-ad717fafa847"
    },
    {
      "name": "Anomaly?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        520,
        800
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "d265579e-01a7-4025-ac95-cbdf5e44768d",
              "leftValue": "={{ Number($json.errors_1h) > 10 || Number($json.attention) > 0 || (Number($json.sent_1h) > 20 && Number($json.failed_1h) / Number($json.sent_1h) > 0.15) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b03dcb33-1bea-4192-a622-ae5130b34fda"
    },
    {
      "name": "Alert Anomaly",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        800
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL_ALERTS }}",
        "options": {
          "timeout": 20000
        },
        "authentication": "none",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: ':warning: LRE health: ' + $json.errors_1h + ' errors/1h, ' + $json.failed_1h + '/' + $json.sent_1h + ' failed sends/1h, ' + $json.attention + ' items need attention (see v_attention_needed).' }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput",
      "id": "c18eaaef-c126-4ba9-ac2d-59c79b2ac03b"
    }
  ],
