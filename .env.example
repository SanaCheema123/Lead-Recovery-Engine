# =============================================================================
# Lead Recovery Engine — environment. Copy to .env and fill in.
# NEVER commit .env. Generate secrets with:  openssl rand -hex 32
# =============================================================================

# ---- Public URL (HTTPS) where Twilio/SendGrid can reach n8n
APP_BASE_URL=https://lre.yourdomain.com
N8N_HOST=lre.yourdomain.com
TZ=America/New_York
N8N_VERSION=latest            # pin to a tested version in production, e.g. 1.x.y

# ---- Postgres (hosts both the "n8n" and "lre" databases)
POSTGRES_USER=lre
POSTGRES_PASSWORD=your_value_here
DATABASE_URL=postgres://lre:change_me_long_random@localhost:5432/lre   # used by npm scripts (via SSH tunnel or on the host)

# ---- n8n
N8N_ENCRYPTION_KEY=your_value_here
N8N_API_KEY=your_value_here

# ---- OpenAI
OPENAI_API_KEY=your_value_here
OPENAI_MODEL=gpt-4.1-mini        # any chat model supporting Structured Outputs; verify current options & pricing

# ---- Twilio (SMS) — use a Messaging Service with A2P 10DLC registration completed
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your_value_here
TWILIO_MESSAGING_SERVICE_SID=MG...
TWILIO_VALIDATE_SIGNATURE=true   # only set false for local testing

# ---- SendGrid (email out + Inbound Parse + Event Webhook)
SENDGRID_API_KEY=your_value_here
LRE_INBOUND_EMAIL_KEY=your_value_here

# ---- CRM (fill the one(s) you use)
GHL_PRIVATE_INTEGRATION_TOKEN=your_value_here
HUBSPOT_PRIVATE_APP_TOKEN=your_value_here

# ---- Calendar (only if using Cal.com instead of GHL calendars)
CALCOM_API_KEY=your_value_here

# ---- Alerts & monitoring
SLACK_WEBHOOK_URL_ALERTS=https://hooks.slack.com/services/...    # errors + daily report
SLACK_WEBHOOK_URL_HANDOFF=https://hooks.slack.com/services/...   # hot leads, handoffs, bookings (sales channel)
HEALTHCHECK_URL=https://hc-ping.com/your-uuid                     # healthchecks.io dead-man switch (optional)

# ---- Internal
LRE_INTERNAL_API_KEY=your_value_here
